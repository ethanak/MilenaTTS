struct milena *milena_Init(
	char *phonefile,
	char *dictfile,
	char *stressfile);

int milena_ReadUserDic(struct milena *cfg,char *fname);
int milena_ReadUserDicWithFlags(struct milena *cfg,char *fname,int flags);
int milena_ReadUserDicLineWithFlags(struct milena *cfg,char *line,int flags,
	char *fname,int lineno);
int milena_ReadPhraser(struct milena *cfg,char *fname);
int milena_ReadStressFile(struct milena *cfg,char *fname);
int milena_ReadIvonaFin(struct milena *cfg,char *fname);

int milena_GetParType(struct milena *cfg,char **str,int spell_empty);

void milena_SetPhraserMode(struct milena *cfg,int mode);
void milena_SetLangMode(struct milena *cfg,char *lang);
int milena_DigitsLimit(struct milena *milena,int limit);

typedef void (milena_errfun)(char *,char *,int);

void milena_registerErrFun(struct milena *cfg,milena_errfun *fun);

int milena_GetPhrase(struct milena *cfg,
	char **str,char *outbuf,int buflen,int *pmode);
int milena_GetPhraseWithPunct(struct milena *cfg,
	char **str,char *outbuf,int buflen,int *pmode,int punct,char *some);
int milena_TranslatePhrase(struct milena* cfg,
