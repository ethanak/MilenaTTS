	char *str,char *outbuf,int buflen);
int milena_Poststresser(char *str,char *outbuf,int buflen);

int milena_ReadVerbs(struct milena *cfg,char *fname);

int milena_ReadKeyChar(struct milena *cfg,char *fname);

int milena_SkipToUnknownWord(struct milena *cfg,char **str);
char *milena_FilePath(char *name,char *buffer);
int milena_IsIgnoredWord(struct milena *cfg,char *slowo);
void milena_Close(struct milena *cfg);
char *milena_GetVersion(void);

#ifdef MILENA_HAS_MORFOLOGIK
int milena_SetMorfologik(struct milena *cfg,void *md);
void *milena_GetMorfologik(char *fname,int shmonly);
void *milena_StartMorfologik(char *path);
void milena_DestroyMorfologik(void);
#endif

int milena_utf2iso(char *src,char *dst,int ignore_oor,int *bad_chars);
int milena_utf2iso_mp(char *instr,char *outstr,int ignore_oor,int *bad_chars,char **instrpos,int maxpos);
int milena_alnum(int znak);
int milena_key(struct milena *cfg,char *key,char *outbuf,int buflen,int *cap);
int milena_char(struct milena *cfg,char *chr,char *outbuf,int buflen,int *cap);
int milena_wchar(struct milena *cfg,int chr,char *outbuf,int buflen,int *cap);

int milena_ivonizer(int mode,char *inbuf,char *outbuf,int outlen);
int milena_ivonizer_n(int mode,char *inbuf,char *outbuf,int outlen,struct milena *cfg);
int milena_ivonizer_nb(int mode,char *inbuf,char *outbuf,int outlen,struct milena *cfg, int bookmode);
void milena_ivo2rh(char *buffer);
int milena_i2uf(char *in, char *out, int outlen);

#ifdef __cplusplus
}
