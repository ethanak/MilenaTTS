
export prefix=/usr
export milena_dir=$(prefix)/share/milena
export doc_dir=$(prefix)/share/doc/milena
export mbrola=/usr/bin/mbrola
export mbrola_voice=/usr/share/mbrola/pl1/pl1
export contrast=contrast
export distro=debian
export morfologik=none

all:
	make -C src all
	make -C data all

clean:
	make -C src clean
	make -C data all


install:
	make -C src install
	ldconfig
	install -m 0755 rasp/milena_say $(DESTDIR)$(prefix)/bin
	make -C data install

uninstall:
	make -C src uninstall
	ldconfig
	rm -f $(DESTDIR)$(prefix)/bin/milena_say
	make -C data uninstall
